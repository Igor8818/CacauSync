# ==============================================================================
# CacauSync API — Template de Variáveis de Ambiente para Produção
# ==============================================================================
# Renomeie este arquivo para .env ou injete as variáveis no seu provedor de nuvem / Docker.
# NUNCA comite arquivos .env reais contendo senhas produtivas no controle de versão.

# Banco de Dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/cacausync_db
DB_USER=cepec_admin
DB_PASSWORD=altere_para_uma_senha_forte_em_producao

# Autenticação e Criptografia JWT
# Gere um segredo de no mínimo 256 bits (ex: openssl rand -base64 32)
JWT_SECRET=altere_para_uma_chave_secreta_jwt_longa_e_aleatoria_com_mais_de_32_bytes

# Armazenamento Físico de Fotos
FOTOS_DIR=./storage/fotos

# Porta do Servidor Spring Boot
PORT=8080
